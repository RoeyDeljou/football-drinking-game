# Copy to .env for local dev. Tests never read this file — they set their own env (SQLite, fixture
# data provider) in apps/api/tests/helpers.ts so the suite never touches the network.

# --- Database -----------------------------------------------------------------
# SQLite for local dev (zero setup). Point at Postgres later by swapping both the value here and
# `provider = "postgresql"` in prisma/schema.prisma, e.g.:
#   DATABASE_URL="postgresql://user:password@localhost:5432/fdg?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------------------------
# HS256 signing secrets. Leave these unset and the server generates a fresh random secret on every
# boot (fine for a laptop — tokens just stop validating across restarts). In production they are
# REQUIRED: the server refuses to start without all three set to a real random value at least 32
# characters long. Generate one per line with `openssl rand -hex 32` — do not reuse the same value
# for more than one variable, and never reuse the example values below (they are placeholders only,
# not secrets — the server hardcodes them as *known-insecure* and refuses to boot on them too).
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Signs room-membership/reconnect tokens (see src/realtime/room-token.ts). Same rules as above.
ROOM_TOKEN_SECRET="replace-me-room-token"

# --- Server -----------------------------------------------------------------------
PORT=4000
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:3000"

# --- Football data (see packages/football-data/README.md for the full list) -----------------------
# `fixture` is recommended for local dev too: real ESPN data is nice-to-have, not required, and the
# fixture provider is fully offline and deterministic. Tests always force `fixture` regardless of
# this value.
FOOTBALL_DATA_PROVIDER="fixture"
